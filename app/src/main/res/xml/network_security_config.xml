<?xml version="1.0" encoding="utf-8"?>
<!--
  Relays are reached over wss:// by default. Plain ws:// is only allowed for loopback and Tailscale
  MagicDNS names; collab frame payloads are end-to-end encrypted (AES-256-GCM) either way.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="true">ts.net</domain>
    </domain-config>
</network-security-config>
